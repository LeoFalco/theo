{
  "name": "theo",
  "version": "1.0.0",
  "description": "Kit com ferramentas e scripts para fluxos de trabalho de desenvolvedores",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "theo": "src/index.js"
  },
  "scripts": {
    "test": "bun test",
    "lint": "bun --bun eslint . --cache",
    "lint:fix": "bun --bun eslint . --fix --cache",
    "updates:check": "bun outdated",
    "updates:install": "bun update --latest",
    "dependencies:check": "bunx --bun depcheck",
    "updates:interactive": "bun update --interactive --latest",
    "audit": "bun audit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeoFalco/theo.git"
  },
  "keywords": [
    "cli",
    "scripts",
    "git",
    "github"
  ],
  "author": "leonardo.falco@outlook.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/LeoFalco/theo/issues"
  },
  "homepage": "https://github.com/LeoFalco/theo#readme",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "1.4.5",
    "eslint": "10.13.0",
    "eslint-plugin-import-x": "4.18.1",
    "globals": "17.14.0"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "3.1173.0",
    "@aws-sdk/credential-providers": "3.1173.0",
    "axios": "1.21.1",
    "chalk": "6.0.1",
    "chalk-table": "1.0.2",
    "clipboardy": "5.3.2",
    "commander": "15.1.0",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "inquirer": "14.2.5",
    "lodash-es": "4.18.1",
    "node-notifier": "12.1.0",
    "octokit": "5.0.5",
    "open": "11.0.4",
    "ora": "10.0.0"
  },
  "packageManager": "bun@1.4.5",
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
